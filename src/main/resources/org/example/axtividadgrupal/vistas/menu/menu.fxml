<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700" prefWidth="1100" style="-fx-background-color: #F5F5F5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.axtividadgrupal.cliente.menu.MenuController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #171E2D; -fx-padding: 20;">

            <Label style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" text="NEXO" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="25">

            <Label style="-fx-font-size: 32px; -fx-font-weight: bold;" text="Menú principal" />

            <Label text="Selecciona el módulo de trabajo" />

            <HBox alignment="CENTER" spacing="20">

                <Button fx:id="btnSeleccion" prefHeight="90" prefWidth="220" text="Selección" />

                <Button fx:id="btmNomina" prefHeight="90" prefWidth="220" text="Nómina" />

            </HBox>

            <HBox alignment="CENTER" spacing="20">

                <Button fx:id="btnContabilidad" prefHeight="90" prefWidth="220" text="Contabilidad" />

                <Button fx:id="btnBiblioteca" prefHeight="90" prefWidth="220" text="Biblioteca" />

            </HBox>

        </VBox>
    </center>

</BorderPane>
