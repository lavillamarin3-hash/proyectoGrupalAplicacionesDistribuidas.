

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        maxHeight="-Infinity"
        maxWidth="-Infinity"
        minHeight="-Infinity"
        minWidth="-Infinity"
        prefHeight="400.0"
        prefWidth="600.0"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.axtividadgrupal.cliente.login.LoginController">

   <center>
      <VBox
              alignment="CENTER"
              maxWidth="520.0"
              prefWidth="520.0"
              spacing="16.0"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 40;"
              BorderPane.alignment="CENTER">

         <children>

            <Label
                    style="-fx-font-weight: bold; -fx-font-size: 34px; -fx-text-fill: #171E2D;"
                    text="Inicia sesión" />

            <Label text="Ingresa tus credenciales" />

            <Label text="Nombre de usuario:" />

            <TextField
                    fx:id="txtUsuario"
                    promptText="Ingresa tu usuario" />

            <Label text="Contraseña:" />

            <PasswordField
                    fx:id="txtClave"
                    promptText="Ingresa tu contraseña" />

            <Label text="¿Necesitas acceso?" />

            <Button
                    fx:id="btnIngresar"
                    mnemonicParsing="false"
                    onAction="#iniciarSesion"
                    style="-fx-background-color: #171E2D; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 8;"
                    text="Iniciar sesión"
                    textFill="WHITE" />

         </children>

         <padding>
            <Insets
                    bottom="30.0"
                    left="30.0"
                    right="30.0"
                    top="30.0" />
         </padding>

      </VBox>
   </center>

</BorderPane>
